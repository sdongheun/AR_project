def node_require(script)
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')

ENVFILES = {
  'Debug' => '$(PODS_ROOT)/../../.env.local',
  'Release' => '$(PODS_ROOT)/../../.env.local',
}

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ARMap' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # 기존 ViroReact/ViroKit 제거됨 (ARCore와 C++ 심볼 충돌 원인)
  
  # Google ARCore Geospatial API for iOS
  pod 'ARCore/Geospatial', '~> 1.41.0'
  
  # 전역 모듈러 헤더 충돌 방지를 위한 구글/Firebase 선별적 모듈 적용
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseABTesting', :modular_headers => true
  pod 'FirebaseRemoteConfig', :modular_headers => true

  # ViroReact 환경 변수 체크 삭제됨

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      if target.name == 'react-native-config'
        target.build_configurations.each do |build_config|
          build_config.build_settings['ENVFILE'] = ENVFILES[build_config.name]
        end
      end

      next unless target.name == 'fmt'

      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end
end
